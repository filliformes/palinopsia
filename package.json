{
  "name": "palinopsia",
  "version": "1.0.1",
  "description": "Palinopsia (Opsia) — an OSC-controlled ISF visual instrument. A lightweight Electron + WebGL2 four-layer compositor with blend modes, feedback, per-source/per-layer/master ISF FX racks, a modulation brain, and a curated Randomize button — the visual sibling to dataFLOU, played over OSC by Pandore. Glitchy, deep, digital-arts; never cheap psychedelia.",
  "main": "out/main/index.js",
  "author": {
    "name": "Vincent Fillion",
    "email": "vfillion.av@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "bonjour-service": "^1.4.2",
    "ffmpeg-static": "^5.3.0",
    "interactive-shader-format": "^2.7.0",
    "osc": "^2.4.5",
    "ws": "8.18.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
