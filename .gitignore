node_modules/
out/
release/
dist-tsc/
.DS_Store
*.log
.env
.env.local

# Personal sessions saved at the repo root during testing
*.opsia.json

# Portable builds dropped at the repo root after a build
/Palinopsia*.exe
/Palinopsia*.dmg

# Downloaded CI artifacts (gh run download)
/artifacts/

# Claude Code workspace — local scratch, not part of the project.
.claude/

# Imported video / media used while testing — not part of the repo.
/media/

# Output recordings + screenshots — local artifacts, not part of the repo.
/Recorded/

# Your own shaders (the Source Editor), saved at the repo root when run from source.
/Shaders/

# The NDI runtime a build ships (see resources/ndi/README.md) : a licensed
# binary put there per machine, never committed.
/resources/ndi/*/*
!/resources/ndi/*/.gitkeep

# Vincent's own prompt notes (kept locally, never published)
Sonification Mode prompt.txt

# The AI depth engine a build ships (Transformers.js, onnxruntime-web, Depth
# Anything V2 Small, about 100 MB) : fetched by `npm run fetch:depth`
# (scripts/fetch-depth.mjs, every file hash-checked), never committed.
/resources/depth/*
!/resources/depth/README.md
